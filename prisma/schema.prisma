// Rolevia AI · Production Prisma Schema (Release 0.1 Production Gate)
// PostgreSQL Relational Persistence with Multi-Tenant Boundaries, Refresh Token Rotation,
// Dynamic FactStore, and Transactional Balanced Credit Journal.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String          @id @default(uuid())
  name          String
  subdomain     String          @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  users              User[]
  creditEntries      CreditJournal[]
  applications       Application[]
  mailboxConnections MailboxConnection[]
  recruiterMessages  RecruiterMessage[]
}

model User {
  id            String            @id @default(uuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email         String            @unique
  passwordHash  String
  name          String
  phone         String?
  location      String?
  linkedin      String?
  github        String?
  roleTitle        String?
  yearsExp         Int               @default(0)
  credits          Int               @default(50) // Available credits
  reservedCredits  Int               @default(0)  // Held credits in flight for active applications
  consumedCredits  Int               @default(0)  // Consumed credits for confirmed submissions
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  profile            CandidateProfile?
  creditEntries      CreditJournal[]
  applications       Application[]
  refreshTokens      RefreshToken[]
  mailboxConnections MailboxConnection[]
  recruiterMessages  RecruiterMessage[]
  screeningAnswers   ScreeningQuestionRecord[]

  @@index([tenantId])
}

model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique
  revoked             Boolean   @default(false)
  revokedAt           DateTime?
  replacedByTokenHash String?
  userAgent           String?
  ipAddress           String?
  expiresAt           DateTime
  createdAt           DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model CandidateProfile {
  id                 String      @id @default(uuid())
  userId             String      @unique
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills             String      // JSON array string of skills
  certifications     String      // JSON array string
  targetRoles        String      // JSON array string
  preferredLocations String      // JSON array string
  needsSponsorship   Boolean     @default(false)
  bachelors          String?
  education          String?
  rawResumeText      String?
  atsReadinessScore  Int         @default(90)
  parsedAt           DateTime?
  facts              FactStore[]
}

model FactStore {
  id                 String           @id @default(uuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  factType           String           // EDUCATION, WORK_EXPERIENCE, PROJECT, SKILL, CERTIFICATION
  title              String
  organization       String?
  startDate          String?
  endDate            String?
  highlights         String           // JSON string of bullet highlights
  metrics            String?          // Measurable impact string
  verified           Boolean          @default(true)
  confidence         Float            @default(1.0)
  createdAt          DateTime         @default(now())

  @@index([candidateProfileId])
  @@index([factType])
}

model CreditJournal {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryType      String   // SUBSCRIPTION_GRANT, APPLICATION_HOLD, APPLICATION_COMMIT, APPLICATION_RELEASE, COURTESY_ADJUSTMENT
  amount         Int      // Positive for credit additions, negative for debits
  balanceAfter   Int      // Strict balance invariant snapshot
  idempotencyKey String   @unique
  referenceType  String?  // REQUISITION, INVOICE, WEBHOOK, ADMIN
  referenceId    String?  // ID of job, order, or invoice
  createdAt      DateTime @default(now())

  @@index([tenantId, userId])
}

model ProcessedWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  signature   String
  processedAt DateTime @default(now())
}

model Job {
  id              String        @id @default(uuid())
  company         String
  title           String
  url             String
  applyUrl        String?
  ats             String
  atsName         String
  location        String?
  jobType         String?
  salary          String?
  postedAt        String?
  requirements    String        // JSON array string
  requisitionHash String        @unique // SHA-256 of normalized URL + title + company for deduplication
  status          String        @default("ACTIVE") // ACTIVE, EXPIRED, ARCHIVED

  // Experience Classification & Intelligence Fields (FEAT-005/006 Integration)
  minExperienceYears             Float?
  maxExperienceYears             Float?
  experienceCategory             String?   // FRESHER, 0-1, 0-2, 1-3, 3-5, 5-8, 8+, NOT_SPECIFIED
  experienceRequirementType      String    @default("UNSPECIFIED") // MANDATORY, PREFERRED, UNSPECIFIED
  experienceSourceText           String?   // Original extracted source text
  experienceExtractionConfidence  Float?    // 0.0 to 1.0 confidence score
  experienceVerificationStatus   String    @default("UNSPECIFIED") // VERIFIED, NEEDS_VERIFICATION, UNSPECIFIED
  isFresherFriendly              Boolean   @default(false)
  acceptsInternships             Boolean?  @default(false)
  graduationYearRestrictions     Json?     // Array of eligible graduation years e.g. ["2025", "2026"]
  skillSpecificExperience        Json?     // Disaggregated skill-specific experience requirements e.g. {"Python": 2}
  sponsorshipAvailable           Boolean?  // Three distinct states: true (available), false (restricted), null (unspecified / unknown)

  lastCheckedAt   DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  applications    Application[]

  @@index([status])
  @@index([requisitionHash])
  @@index([minExperienceYears])
  @@index([maxExperienceYears])
  @@index([isFresherFriendly])
  @@index([experienceCategory])
  @@index([experienceVerificationStatus])
}

model Application {
  id                  String             @id @default(uuid())
  tenantId            String
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId               String?
  job                 Job?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  company             String
  position            String
  ats                 String
  url                 String
  status              String             // DRAFT, OPTIMIZING, PENDING_REVIEW, APPROVED, QUEUED_RESERVED, RUNNING_PRE_SUBMIT, NEEDS_USER_ACTION, READY_FOR_SUBMISSION, SUBMISSION_IN_FLIGHT, SUBMITTED_CONFIRMED, OUTCOME_UNKNOWN, FAILED_CONFIRMED, SKIPPED
  confirmationNumber  String?
  receiptUrl          String?
  diffData            String?            // JSON structured diff
  receiptData         String?            // JSON structured submission proof
  approvalSignature   String?            // Candidate HMAC authorization signature
  approvalPayload     String?            // Structured candidate authorization binding (JSON)
  approvalTimestamp   DateTime?          // Timestamp when candidate authorized submission
  approvedContentHash String?            // Hash of approved documents
  executionAttempts   Int                @default(0)
  lastError           String?            // Error or escalation note
  quarantineReason    String?            // Reason for OUTCOME_UNKNOWN quarantine
  submissionEvidence  String?            // Path to captured screenshot receipt
  screeningAnswers    Json?              // Extracted and mapped screening Q&A
  stage               String             @default("APPLIED") // APPLIED, SCREENING, INTERVIEWING, OFFER, REJECTED, WITHDRAWN
  events              ApplicationEvent[]
  recruiterMessages   RecruiterMessage[]
  screeningRecords    ScreeningQuestionRecord[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([tenantId, userId])
  @@index([status])
  @@index([stage])
}

model ApplicationEvent {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    String?
  toStatus      String
  eventType     String      // STATE_TRANSITION, HUMAN_ESCALATION, SCREENSHOT_CAPTURED, CONFIRMATION_EXTRACTED, CREDIT_HOLD, CREDIT_COMMIT, CREDIT_RELEASE
  payload       Json?       // Event telemetry payload
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

// ============================================================================
// Release 0.3: Recruiter Email Intelligence & Screening Question Models
// ============================================================================

model MailboxConnection {
  id                    String             @id @default(uuid())
  tenantId              String
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId                String
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              String             // GMAIL, OUTLOOK, IMAP
  emailAddress          String
  encryptedAccessToken  String
  encryptedRefreshToken String?
  tokenExpiry           DateTime?
  scopes                String             // JSON array string of approved scopes
  status                String             @default("ACTIVE") // ACTIVE, DISCONNECTED, ERROR
  lastError             String?
  lastSyncedAt          DateTime?
  messages              RecruiterMessage[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([userId, provider, emailAddress])
  @@index([tenantId, userId])
}

model RecruiterMessage {
  id                  String             @id @default(uuid())
  tenantId            String
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  mailboxId           String
  mailbox             MailboxConnection  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  applicationId       String?
  application         Application?       @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  providerMessageId   String             @unique // External message ID for deduplication
  threadId            String?
  senderEmail         String
  senderName          String?
  subject             String
  snippet             String?
  bodyCleaned         String?
  dateReceived        DateTime
  category            String             // INTERVIEW_INVITE, TECHNICAL_ASSESSMENT, OFFER, REJECTION, STATUS_UPDATE, GENERAL
  confidence          Float              @default(1.0)
  isDecisionConfirmed Boolean            @default(false)
  decisionStatus      String             @default("INFERRED") // CONFIRMED, INFERRED, UNVERIFIED
  extractedDates      Json?              // Extracted interview times, calendar info
  assessmentLinks     Json?              // Coding test URLs, deadlines
  draftReply          String?            // AI drafted reply (requires user approval)
  draftReplyStatus    String?            // DRAFT_PENDING_APPROVAL, APPROVED, DISCARDED
  metadata            Json?              // Headers, raw match details
  createdAt           DateTime           @default(now())

  @@index([tenantId, userId])
  @@index([applicationId])
  @@index([category])
  @@index([decisionStatus])
}

model EmailDedupLedger {
  id                String   @id @default(uuid())
  providerMessageId String   @unique
  mailboxId         String
  processedAt       DateTime @default(now())

  @@index([mailboxId])
}

model ScreeningQuestionRecord {
  id                  String       @id @default(uuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId       String?
  application         Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionText        String
  questionNormalized  String
  category            String       // FACTUAL, NARRATIVE, LEGAL_ATTESTATION, SENSITIVE_DISCLOSURE, UNKNOWN
  generatedAnswer     String?
  candidateAnswer     String?      // Candidate modified or approved answer
  status              String       @default("PENDING_REVIEW") // AUTO_GENERATED, APPROVED, NEEDS_USER_ACTION, REJECTED
  groundedFactIds     Json?        // List of source FactStore IDs
  version             Int          @default(1)
  isReusable          Boolean      @default(false) // Whether candidate saved as reusable preference
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([userId])
  @@index([applicationId])
  @@index([category])
}

// ============================================================================
// Release 0.4: Database-Level Submission Locks & Execution Idempotency
// ============================================================================

model SubmissionAttemptLock {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  userId         String   @map("user_id")
  applicationId  String   @map("application_id")
  attemptKey     String   @unique @map("attempt_key")
  requisitionKey String   @map("requisition_key")
  status         String   // IN_FLIGHT, COMPLETED, QUARANTINED, FAILED
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([tenantId, userId, requisitionKey], map: "unique_candidate_active_requisition")
  @@index([applicationId])
  @@map("submission_attempt_locks")
}



